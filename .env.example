# ==============================================================================
# TransLumina Environment Configuration
# ==============================================================================

# Server Listening Port (Default: 5050)
PORT=5050
NODE_ENV=production

# ------------------------------------------------------------------------------
# Real Translation Providers (Optional: system works out-of-the-box with
# built-in Google Translate and MyMemory fallback engines)
# ------------------------------------------------------------------------------

# Optional: DeepL API (if using DeepL Pro or Free API Key)
# Format: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx"
DEEPL_API_KEY=

# Optional: Azure Cognitive Services Translator
# Obtain from Azure Portal -> Azure Translator resource
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Optional: Google Cloud Translation API Key
GOOGLE_TRANSLATE_API_KEY=

# Optional: MyMemory Translation Custom Key or Developer Email
MYMEMORY_EMAIL=
MYMEMORY_API_KEY=

# Optional: Self-hosted LibreTranslate Instance URL
LIBRETRANSLATE_URL=
